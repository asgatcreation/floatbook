# FloatBook environment settings.
# Copy to .env for local development (composer run setup does this for you).
# Never commit .env. Production values are set in the Render dashboard.

APP_NAME=FloatBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
SERVER_PORT=8010
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: the Docker database from compose.yaml (port 5433).
# Production: set DB_URL to your Neon connection string (it overrides the values below).
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=floatbook
DB_USERNAME=floatbook
DB_PASSWORD=floatbook
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Email. Local development writes emails to storage/logs/laravel.log.
# Production uses the Brevo HTTP API (Render's free plan blocks SMTP).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

VITE_APP_NAME="${APP_NAME}"
